# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=booty_db
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/booty_db?schema=public

# Admin Security & JWT Session
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=replace_with_a_secure_admin_password

# Application Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
