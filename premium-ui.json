{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "ar-JO",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Form", "Scrollbar", "Toast", "CRUD", "Select/Listbox", "Date"],
  "ownership": { "Select/Listbox": "native", "Date": "native" },
  "requiredCommands": ["unit", "typecheck", "build"],
  "commands": {
    "unit": "npm test -- --maxWorkers=2 --minWorkers=1",
    "typecheck": "npx tsc --noEmit --incremental false",
    "build": "npm run build"
  }
}
